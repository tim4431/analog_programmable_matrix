Cref0_2 ref0_2 0 5p
Rbp0_3 p0 sp0_3 150
Rbn0_3 n0 sn0_3 150
Cp0_3 sp0_3 0 {csw}
Cn0_3 sn0_3 0 {csw}
Rswp0_3 sp0_3 ref0_3 {if(sg<.5,ron,1T)}
Rswn0_3 sn0_3 ref0_3 {if(sg>.5,ron,1T)}
Rref0_3 ref0_3 0 {rdac}
Cref0_3 ref0_3 0 5p
Ebw0 bwsource0 0 ref0_0 0 1
Rbw0 bwsource0 filt0 1k
Cbw0 filt0 0 {1/(2*pi*1k*fbw)}
Gdac0 0 inn0 filt0 0 {q/rdac}
Rfb0 weight0 inn0 {rdac}
Rout0 inn0 0 {rdac}
Co0 inn0 0 {cout+cstray}
Cf0 weight0 inn0 {cf+cfstray}
Xamp0 0 inn0 vp vn weight0 weight0 vp ADA4899
Rsum0 weight0 snode 1k
VIN1 a1 0 0
Rin1 a1 ai1 33
Rb1 a1 0 1Meg
Xbuf1 ai1 buf1 buf1 vp vn OPA2810
